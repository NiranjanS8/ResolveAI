# Database
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=resolveai
POSTGRES_DB=resolveai
DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5433/resolveai

# Ticket-processing queue. Jobs live in Postgres and the worker runs inside the
# API process; set WORKER_ENABLED=false to run an API instance that only serves
# requests while another process drains the queue.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300

# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Provider preference (comma-separated; first configured key wins).
# Options: gemini, mistral, anthropic, openai. Leave blank to auto-detect.
LLM_PROVIDER_ORDER=
# Embedding provider used for retrieval. Options: gemini, mistral, openai.
# Leave blank to auto-detect. Changing this requires re-running ingest_knowledge.py.
EMBEDDING_PROVIDER=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1